---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SplashLoader from '../components/SplashLoader.astro';
import { organizationLd, websiteLd, breadcrumbLd, ldScript } from '../lib/seo';

interface Props {
  title: string;
  description?: string;
  keywords?: string | string[];
  /** Optional extra JSON-LD payload(s) injected before </head>. */
  jsonLd?: unknown[];
  /** Breadcrumb trail for BreadcrumbList schema. If omitted, no crumb schema. */
  breadcrumb?: Array<{ name: string; url: string }>;
  /** Custom OG image path (PNG); defaults to /og-image.png. */
  ogImage?: string;
  /** Hide top layout nav if embedded inside page hero */
  hideNav?: boolean;
}

const {
  title,
  description = 'OllaSoftware Blog — Long-form 5,000-word brand deep-dives on every Olla product. Honest, technical, useful.',
  keywords,
  jsonLd = [],
  breadcrumb,
  ogImage = '/og-image.png',
  hideNav = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageAbs = new URL(ogImage, Astro.site).toString();
const keywordsStr = Array.isArray(keywords) ? keywords.join(', ') : keywords;

// Always inject Organization + WebSite; add Breadcrumb if provided; then any
// page-specific schemas the caller passed via `jsonLd`.
const allLd: unknown[] = [organizationLd, websiteLd];
if (breadcrumb && breadcrumb.length > 0) allLd.push(breadcrumbLd(breadcrumb));
for (const x of jsonLd) allLd.push(x);
---
<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Google Fonts: Lato -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,300;0,400;0,700;0,900;1,300;1,400;1,700;1,900&display=swap"
      rel="stylesheet"
    />

    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywordsStr && <meta name="keywords" content={keywordsStr} />}
    <link rel="canonical" href={canonical} />

    <!-- Favicons -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" type="image/png" href="/logo.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:site_name" content="OllaSoftware Blog" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="OllaSoftware Blog" href="/rss.xml" />

    <!-- Structured data -->
    {allLd.map((ld) => <Fragment set:html={ldScript(ld)} />)}
  </head>
  <body>
    <SplashLoader />
    {!hideNav && <Header />}
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
