---
import { o, services } from '../../lib/tokens';

// Short labels for footer-column tightness; full titles live on each page.
const rankingLinks: Array<[string, string]> = [
  ['AI Software · BLR', '/top-10/ai-software-development-companies-bangalore/'],
  ['Software Dev · BLR', '/top-10/software-development-companies-bangalore/'],
  ['AEO · India', '/top-10/aeo-companies-india/'],
  ['SEO · BLR', '/top-10/seo-agencies-bangalore/'],
  ['Social · BLR', '/top-10/social-media-marketing-agencies-bangalore/'],
  ['Performance · BLR', '/top-10/performance-marketing-agencies-bangalore/'],
];

const cols: Array<[string, Array<[string, string]>]> = [
  ['SERVICES', services.map(s => [s.name, `/services/${s.slug}/`])],
  ['TOP 10 RANKINGS', rankingLinks],
  ['WORK',     [['Case studies', '/work/'], ['Recent work', '/work/'], ['Industries', '/work/#industries'], ['Sample SOW', '/process/#sow']]],
  ['COMPANY',  [['Process', '/process/'], ['About', '/about/'], ['Blog', '/blog/'], ['Jobs · 19 roles', '/jobs/'], ['Press', '/about/#press']]],
  ['TRUST',    [['SOC 2', '/process/#security'], ['GDPR / DPA', '/process/#gdpr'], ['Master MSA', '/process/#msa'], ['Security FAQ', '/process/#bounty']]],
];

const year = new Date().getFullYear();
---
<footer class="foot">
  <div class="foot-container">
    <div class="grid">
      <div class="brand-col">
        <div class="brand">
          <img src="/footer-building-logo.png" alt="ollasoftware logo" class="brand-logo" width="38" height="44" />
          <span class="brand-name">ollasoftware</span>
        </div>
        <p class="tagline">
          Pioneer AI software development company in India. Headquartered in
          Bangalore. Owners of 40+ AI brands. We build custom AI, software,
          AEO/SEO, social and performance for clients worldwide.
        </p>
        <form class="newsletter" onsubmit="event.preventDefault();">
          <input
            type="email"
            placeholder="you@company.com"
            class="newsletter-input"
            aria-label="Email for field notes newsletter"
          />
          <button type="submit" class="newsletter-btn">
            <span>field notes</span>
            <span class="arrow">→</span>
          </button>
        </form>
        <p class="newsletter-foot mono">monthly · case studies &amp; lessons · no funnel</p>
      </div>

      {cols.map(([head, items]) => (
        <div class="col">
          <div class="col-head mono">{head}</div>
          <ul>
            {items.map(([label, to]) => (
              <li><a href={to}>{label}</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="legal">
      <span class="mono">© {year} Ollasoftware, Inc. · Bangalore · Brooklyn · Lisboa</span>
      <span class="mono">40+ AI brands shipped · 1 senior team</span>
    </div>
  </div>
</footer>

<style>
  .foot {
    padding: clamp(48px, 6vw, 72px) clamp(16px, 4vw, 56px) 36px;
    background: #00508C;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    color: #FFFFFF;
    position: relative;
    overflow: hidden;
    width: 100%;
    box-sizing: border-box;
  }

  .foot-container {
    max-width: 1280px;
    margin: 0 auto;
    width: 100%;
  }

  .grid {
    display: grid;
    /* 1 Brand Column + 5 Link Columns */
    grid-template-columns: 1.4fr repeat(5, 1fr);
    gap: 36px;
    margin-bottom: 56px;
  }

  .brand-col {
    display: flex;
    flex-direction: column;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
  }

  .brand-logo {
    height: 34px;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 0 10px rgba(0, 163, 255, 0.5));
  }

  .brand-name {
    font-family: 'Lato', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
    font-weight: 900;
    font-size: 23px;
    color: #ffffff;
    letter-spacing: -0.75px;
  }

  .tagline {
    font-family: 'Lato', sans-serif;
    font-size: 12.5px;
    color: #E1EFFF;
    line-height: 1.6;
    margin: 0 0 20px;
    max-width: 290px;
  }

  .newsletter {
    display: flex;
    align-items: stretch;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 8px;
    overflow: hidden;
    max-width: 320px;
    width: 100%;
    height: 38px;
    background: #0064A5;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
    box-sizing: border-box;
  }

  .newsletter-input {
    flex: 1;
    border: none;
    background: transparent;
    color: #FFFFFF;
    padding: 0 12px;
    font-size: 11.5px;
    font-family: 'Lato', sans-serif;
    outline: none;
    min-width: 0;
  }

  .newsletter-input::placeholder {
    color: #9FBDE8;
  }

  .newsletter-btn {
    border: none;
    background: #1D6AF3;
    color: #ffffff;
    padding: 0 14px;
    font-size: 11px;
    font-weight: 600;
    font-family: 'Lato', sans-serif;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    white-space: nowrap;
    flex-shrink: 0;
    transition: background 0.2s ease;
  }

  .newsletter-btn:hover {
    background: #1557c0;
  }

  .newsletter-btn .arrow {
    font-size: 11px;
    display: inline-block;
    transition: transform 0.2s ease;
  }

  .newsletter-btn:hover .arrow {
    transform: translateX(2px);
  }

  .newsletter-foot {
    font-size: 10px;
    color: #9FBDE8;
    margin: 10px 0 0;
  }

  .col-head {
    font-family: 'Lato', sans-serif;
    font-size: 11px;
    font-weight: 700;
    color: #ffffff;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    margin-bottom: 16px;
  }

  .col ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .col a {
    font-family: 'Lato', sans-serif;
    color: #D6E4FF;
    font-size: 12.5px;
    text-decoration: none;
    transition: color 0.15s ease, transform 0.15s ease;
    display: inline-block;
  }

  .col a:hover {
    color: #60a5fa;
    transform: translateX(2px);
  }

  .legal {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    flex-wrap: wrap;
    gap: 12px;
  }

  .legal span {
    font-size: 11px;
    color: #9FBDE8;
  }

  @media (max-width: 1100px) {
    .grid {
      grid-template-columns: 1fr 1fr 1fr;
      gap: 36px;
    }
    .brand-col {
      grid-column: 1 / -1;
      margin-bottom: 12px;
    }
  }

  @media (max-width: 700px) {
    .foot {
      padding: 32px 14px 24px;
    }
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
      gap: 20px 14px;
      margin-bottom: 28px;
    }
    .brand-col {
      grid-column: 1 / -1;
      margin-bottom: 8px;
    }
    .brand-name {
      font-size: 14.5px;
    }
    .brand-logo {
      height: 22px;
    }
    .tagline {
      font-size: 11px;
      margin-bottom: 12px;
      max-width: 100%;
    }
    .newsletter {
      height: 34px;
      max-width: 100%;
    }
    .newsletter-input {
      font-size: 10.5px;
      padding: 0 10px;
    }
    .newsletter-btn {
      font-size: 10px;
      padding: 0 10px;
    }
    .col-head {
      font-size: 10px;
      margin-bottom: 8px;
      letter-spacing: 0.8px;
    }
    .col ul {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .col a {
      font-size: 11px;
      line-height: 1.35;
    }
    .legal {
      flex-direction: column;
      align-items: flex-start;
      gap: 6px;
      padding-top: 16px;
    }
    .legal span {
      font-size: 9.5px;
    }
  }

  @media (max-width: 480px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
      gap: 18px 10px;
    }
    .col a {
      font-size: 10.5px;
    }
  }
</style>
