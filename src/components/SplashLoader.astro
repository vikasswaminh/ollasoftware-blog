---
// SplashLoader.astro — animated intro splash screen
// ONLY triggers when tapping/clicking the left brand logo
---

<div id="splash-loader" class="splash-loader hidden" style="display: none;" aria-hidden="true" role="presentation">
  <div class="splash-inner">
    <!-- Logo top -->
    <div class="splash-logo-wrap">
      <img
        src="/logo.png"
        alt="OllaSoftware Logo"
        class="splash-logo"
      />
    </div>
    <!-- Brand text -->
    <div class="splash-brand">
      <span class="splash-brand-olla">ollasoftware</span><span class="splash-brand-blog">blog</span>
    </div>
    <!-- Pulse loader -->
    <div class="splash-dots" aria-hidden="true">
      <span class="dot"></span>
      <span class="dot"></span>
      <span class="dot"></span>
    </div>
  </div>
</div>

<style>
  .splash-loader {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    transition: opacity 0.4s cubic-bezier(0.4, 0, 0.2, 1),
                visibility 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .splash-loader.hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .splash-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    animation: splashFadeUp 0.45s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes splashFadeUp {
    from { opacity: 0; transform: translateY(18px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .splash-logo-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .splash-logo {
    height: 64px;
    width: auto;
    max-width: 80px;
    object-fit: contain;
    display: block;
    animation: logoBounce 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 0.1s both;
  }

  @keyframes logoBounce {
    from { opacity: 0; transform: scale(0.7) rotate(-4deg); }
    to   { opacity: 1; transform: scale(1) rotate(0deg); }
  }

  .splash-brand {
    display: flex;
    align-items: baseline;
    gap: 0;
    animation: splashFadeUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) 0.15s both;
  }

  .splash-brand-olla {
    font-family: 'Lato', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 2rem;
    font-weight: 900;
    letter-spacing: -0.04em;
    color: #1d4ed8;
  }

  .splash-brand-blog {
    font-family: 'Lato', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 2rem;
    font-weight: 900;
    letter-spacing: -0.03em;
    color: #1D6AF3;
    margin-left: 2px;
  }

  /* Animated dots */
  .splash-dots {
    display: flex;
    align-items: center;
    gap: 6px;
    animation: splashFadeUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) 0.25s both;
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #1d4ed8;
    animation: dotPulse 1.2s ease-in-out infinite;
  }

  .dot:nth-child(1) { animation-delay: 0s; background: #1d4ed8; }
  .dot:nth-child(2) { animation-delay: 0.2s; background: #3b82f6; }
  .dot:nth-child(3) { animation-delay: 0.4s; background: #1d4ed8; }

  @keyframes dotPulse {
    0%, 80%, 100% { transform: scale(0.7); opacity: 0.5; }
    40%            { transform: scale(1.15); opacity: 1; }
  }
</style>

<script is:inline>
  (function() {
    var splash = document.getElementById('splash-loader');
    if (!splash) return;

    // Attach global click listener to set flag whenever the left brand logo is clicked
    document.addEventListener('click', function(e) {
      var brandLink = e.target.closest('a.brand');
      if (brandLink) {
        try {
          sessionStorage.setItem('olla-trigger-splash', '1');
        } catch (err) {}
      }
    });

    // Check if loading page was explicitly triggered by tapping the left logo
    var shouldShow = false;
    try {
      if (sessionStorage.getItem('olla-trigger-splash') === '1') {
        shouldShow = true;
        sessionStorage.removeItem('olla-trigger-splash');
      }
    } catch (err) {}

    // If NOT triggered by logo tap, ensure splash loader is completely hidden
    if (!shouldShow) {
      splash.classList.add('hidden');
      splash.style.display = 'none';
      return;
    }

    // Show splash loader when tapping the left logo
    splash.style.display = 'flex';
    splash.classList.remove('hidden');

    var timer = setTimeout(function() {
      splash.classList.add('hidden');
      setTimeout(function() {
        splash.style.display = 'none';
      }, 500);
    }, 1100);

    function dismiss() {
      clearTimeout(timer);
      splash.classList.add('hidden');
      setTimeout(function() {
        splash.style.display = 'none';
      }, 500);
    }

    document.addEventListener('click', dismiss, { once: true });
    document.addEventListener('keydown', dismiss, { once: true });
    document.addEventListener('touchstart', dismiss, { once: true, passive: true });
  })();
</script>
