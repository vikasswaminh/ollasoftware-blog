---
// SplashLoader.astro — animated intro splash screen
// Triggers ONLY on:
// 1. Initial site session open / web browser reload/refresh
// 2. Tapping/clicking the brand logo
// Does NOT trigger on regular page navigation (e.g., Tags, About, blog posts)
---

<div id="splash-loader" class="splash-loader hidden" style="display: none;" aria-hidden="true" role="presentation">
  <div class="splash-inner">
    <!-- Logo top -->
    <div class="splash-logo-wrap">
      <picture>
        <source srcset="/splash-logo.webp" type="image/webp" />
        <img
          src="/splash-logo.png"
          alt="OllaSoftware Building Logo"
          class="splash-logo"
        />
      </picture>
    </div>
    <!-- Brand text -->
    <div class="splash-brand">
      <span class="splash-brand-olla">ollasoftware</span><span class="splash-brand-blog">blog</span>
    </div>
    <!-- Pulse loader -->
    <div class="splash-dots" aria-hidden="true">
      <span class="dot"></span>
      <span class="dot"></span>
      <span class="dot"></span>
    </div>
  </div>
</div>

<style>
  .splash-loader {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    transition: opacity 0.45s cubic-bezier(0.4, 0, 0.2, 1),
                visibility 0.45s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .splash-loader.hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .splash-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    animation: splashFadeUp 0.45s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes splashFadeUp {
    from { opacity: 0; transform: translateY(18px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .splash-logo-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .splash-logo {
    height: 160px;
    width: auto;
    max-width: 220px;
    object-fit: contain;
    display: block;
    animation: logoBounce 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) 0.1s both;
  }

  @keyframes logoBounce {
    from { opacity: 0; transform: scale(0.7) rotate(-4deg); }
    to   { opacity: 1; transform: scale(1) rotate(0deg); }
  }

  .splash-brand {
    display: flex;
    align-items: baseline;
    gap: 0;
    animation: splashFadeUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) 0.15s both;
  }

  .splash-brand-olla {
    font-family: 'Lato', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 2.2rem;
    font-weight: 900;
    letter-spacing: -0.04em;
    color: #1d4ed8;
  }

  .splash-brand-blog {
    font-family: 'Lato', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 2.2rem;
    font-weight: 900;
    letter-spacing: -0.03em;
    color: #1D6AF3;
    margin-left: 2px;
  }

  /* Animated dots */
  .splash-dots {
    display: flex;
    align-items: center;
    gap: 6px;
    animation: splashFadeUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) 0.25s both;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #1d4ed8;
    animation: dotPulse 1.2s ease-in-out infinite;
  }

  .dot:nth-child(1) { animation-delay: 0s; background: #1d4ed8; }
  .dot:nth-child(2) { animation-delay: 0.2s; background: #3b82f6; }
  .dot:nth-child(3) { animation-delay: 0.4s; background: #1d4ed8; }

  @keyframes dotPulse {
    0%, 80%, 100% { transform: scale(0.7); opacity: 0.5; }
    40%            { transform: scale(1.15); opacity: 1; }
  }
</style>

<script is:inline>
  (function() {
    var splash = document.getElementById('splash-loader');
    if (!splash) return;

    function playSplash() {
      splash.style.display = 'flex';
      splash.classList.remove('hidden');

      setTimeout(function() {
        splash.classList.add('hidden');
        setTimeout(function() {
          splash.style.display = 'none';
        }, 500);
      }, 950);
    }

    function shouldShowSplash() {
      try {
        // 1. Check if user tapped logo (sessionStorage flag)
        if (sessionStorage.getItem('trigger_splash') === 'true') {
          sessionStorage.removeItem('trigger_splash');
          return true;
        }

        // 2. Check if this is a web browser reload/refresh
        var navEntries = (window.performance && typeof window.performance.getEntriesByType === 'function')
          ? window.performance.getEntriesByType('navigation')
          : null;
        if (navEntries && navEntries.length > 0) {
          if (navEntries[0].type === 'reload') {
            return true;
          }
        } else if (window.performance && window.performance.navigation && window.performance.navigation.type === 1) {
          return true;
        }

        // 3. Check if initial session open (opening website for first time in tab)
        if (!sessionStorage.getItem('site_visited_session')) {
          sessionStorage.setItem('site_visited_session', 'true');
          return true;
        }
      } catch (e) {
        // Fallback safely if storage/performance unavailable
      }
      return false;
    }

    if (shouldShowSplash()) {
      playSplash();
    } else {
      splash.style.display = 'none';
      splash.classList.add('hidden');
    }

    // Global listener for tapping/clicking on the brand logo
    document.addEventListener('click', function(e) {
      var brandLink = e.target.closest('a.brand, .brand-logo-img, .brand-text-wrapper, .brand-col .brand');
      if (brandLink) {
        sessionStorage.setItem('trigger_splash', 'true');
        playSplash();
      }
    });
  })();
</script>
