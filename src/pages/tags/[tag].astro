<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    var searchInput = document.getElementById('sidebar-tag-search');
    var tagRows = document.querySelectorAll('#sidebar-tags-list .sidebar-tag-row');
    var countBadge = document.getElementById('sidebar-count');

    // Sidebar search filter
    if (searchInput) {
      searchInput.addEventListener('input', function() {
        var query = (this.value || '').trim().toLowerCase().replace(/^#/, '');
        var visibleCount = 0;

        tagRows.forEach(function(row) {
          var tag = row.getAttribute('data-tag') || '';
          if (!query || tag.includes(query)) {
            row.style.display = 'flex';
            visibleCount++;
          } else {
            row.style.display = 'none';
          }
        });

        if (countBadge) countBadge.textContent = visibleCount;
      });
    }

    // In-tag article sorting script
    var sortRecentBtn = document.getElementById('sort-recent');
    var sortLongestBtn = document.getElementById('sort-longest');
    var sortQuickestBtn = document.getElementById('sort-quickest');
    var postsList = document.getElementById('tag-posts-list');

    if (postsList && sortRecentBtn && sortLongestBtn && sortQuickestBtn) {
      var articles = Array.from(postsList.children);

      function setSortActive(btn) {
        [sortRecentBtn, sortLongestBtn, sortQuickestBtn].forEach(function(b) {
          b.classList.remove('active');
        });
        btn.classList.add('active');
      }

      sortRecentBtn.addEventListener('click', function() {
        setSortActive(this);
        articles.sort(function(a, b) {
          return new Date(b.getAttribute('data-date')) - new Date(a.getAttribute('data-date'));
        });
        articles.forEach(function(art) { postsList.appendChild(art); });
      });

      sortLongestBtn.addEventListener('click', function() {
        setSortActive(this);
        articles.sort(function(a, b) {
          return parseInt(b.getAttribute('data-read-time') || '0', 10) - parseInt(a.getAttribute('data-read-time') || '0', 10);
        });
        articles.forEach(function(art) { postsList.appendChild(art); });
      });

      sortQuickestBtn.addEventListener('click', function() {
        setSortActive(this);
        articles.sort(function(a, b) {
          return parseInt(a.getAttribute('data-read-time') || '0', 10) - parseInt(b.getAttribute('data-read-time') || '0', 10);
        });
        articles.forEach(function(art) { postsList.appendChild(art); });
      });
    }
  });
</script>
