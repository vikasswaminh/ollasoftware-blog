---
import Layout from '../../layouts/Layout.astro';
import { getAllTags, postsByTag } from '../../lib';
import type { BlogPost } from '../../lib';

export function getStaticPaths() {
  const tags = getAllTags();
  return tags.map(({ tag }) => ({
    params: { tag },
    props: { tag, posts: postsByTag(tag) },
  }));
}

interface Props {
  tag: string;
  posts: readonly BlogPost[];
}

const { tag, posts } = Astro.props;
const allTags = getAllTags();

const categoryColors: Record<string, { bg: string; text: string; border: string }> = {
  ai:       { bg: '#f0fdf4', text: '#16a34a', border: '#bbf7d0' },
  api:      { bg: '#eff6ff', text: '#2563eb', border: '#bfdbfe' },
  security: { bg: '#faf5ff', text: '#7c3aed', border: '#e9d5ff' },
  saas:     { bg: '#eff6ff', text: '#2563eb', border: '#bfdbfe' },
  training: { bg: '#f0fdfa', text: '#0d9488', border: '#99f6e4' },
  education:{ bg: '#f0fdfa', text: '#0d9488', border: '#99f6e4' },
};
---

<Layout title={`#${tag} — OllaSoftware Blog`} description={`All posts tagged #${tag}. ${posts.length} deep-dive${posts.length !== 1 ? 's' : ''} found.`}>
  <div class="tag-page-wrap">

    <!-- Left Sidebar: All Tags -->
    <aside class="tags-sidebar">
      <div class="sidebar-card">
        <div class="sidebar-header">
          <span class="sidebar-title">All Tags</span>
          <span class="sidebar-count mono" id="sidebar-count">{allTags.length}</span>
        </div>
        <div class="sidebar-search-box">
          <svg class="sidebar-search-icon" viewBox="0 0 20 20" fill="currentColor" width="14" height="14" aria-hidden="true">
            <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd"/>
          </svg>
          <input
            type="text"
            id="sidebar-tag-search"
            class="sidebar-search-input mono"
            placeholder="Search tags..."
            aria-label="Search tags"
          />
        </div>
        <nav class="sidebar-tags-list" id="sidebar-tags-list">
          {allTags.map(({ tag: t, count }) => (
            <a
              href={`/tags/${t}/`}
              class={`sidebar-tag-row ${t === tag ? 'active' : ''}`}
              data-tag={t.toLowerCase()}
            >
              <span class="sidebar-tag-name">#{t}</span>
              <span class="sidebar-tag-num mono">{count}</span>
            </a>
          ))}
        </nav>
      </div>
    </aside>

    <!-- Right: Posts for selected tag -->
    <main class="tag-main">
      <!-- Header -->
      <div class="tag-main-header">
        <a href="/tags/" class="tag-back mono">← All tags</a>
        <div class="tag-hero-row">
          <div>
            <h1 class="tag-h1">
              <span class="tag-hash">#</span>{tag}
            </h1>
            <p class="tag-sub">
              {posts.length} deep-dive{posts.length !== 1 ? 's' : ''} tagged with this topic
            </p>
          </div>
        </div>
      </div>

      <!-- Posts -->
      {posts.length === 0 ? (
        <div class="tag-empty">
          <div class="tag-empty-icon">🔍</div>
          <p>No posts yet for <strong>#{tag}</strong></p>
          <a href="/tags/">Browse all tags →</a>
        </div>
      ) : (
        <div class="tag-posts-list">
          {posts.map((post) => {
            const colors = categoryColors[post.category] ?? { bg: '#f8fafc', text: '#475467', border: '#e2e8f0' };
            return (
              <article class="tag-card-item">
                <!-- Category + Domain row -->
                <div class="tag-card-top">
                  <span class="post-cat" style={`background:${colors.bg}; color:${colors.text}; border-color:${colors.border}`}>
                    {post.category}
                  </span>
                  <span class="post-domain mono">{post.brandDomain}</span>
                  <span class="post-read mono">{post.readingTimeMin} min read</span>
                </div>

                <!-- Brand name linked -->
                <h2 class="post-brand">
                  <a href={`/blog/${post.slug}/`} class="post-brand-link">{post.brand}</a>
                </h2>

                <!-- Tagline -->
                <p class="post-tagline">{post.brandTagline}</p>

                <!-- Description -->
                <p class="post-desc">{post.metaDescription}</p>

                <!-- Tags & CTA footer -->
                <div class="tag-card-foot">
                  <div class="post-tags">
                    {post.tags.map((t) => (
                      <a
                        class={`post-tag mono ${t === tag ? 'post-tag-active' : ''}`}
                        href={`/tags/${t}/`}
                      >
                        #{t}
                      </a>
                    ))}
                  </div>
                  <a href={`/blog/${post.slug}/`} class="post-read-link">
                    Read deep-dive →
                  </a>
                </div>
              </article>
            );
          })}
        </div>
      )}
    </main>
  </div>
</Layout>

<style>
  /* ── Page shell ── */
  .tag-page-wrap {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 2rem;
    max-width: 1100px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 5rem;
    align-items: start;
  }

  @media (max-width: 768px) {
    .tag-page-wrap {
      grid-template-columns: 1fr;
      padding: 1.5rem 1rem 4rem;
      gap: 1.75rem;
    }
    .tags-sidebar {
      position: static;
      order: 2;
    }
    .tag-main {
      order: 1;
    }
    .sidebar-tags-list {
      max-height: 220px;
    }
    .tag-main-header .tag-h1 {
      font-size: 1.85rem;
    }
    .post-card-body {
      padding: 1.25rem 1.1rem;
    }
  }

  /* ── Left Sidebar ── */
  .tags-sidebar {
    position: sticky;
    top: 5rem;
  }

  .sidebar-card {
    background: #fff;
    border: 1.5px solid #e2e8f0;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 2px 12px rgba(15, 23, 42, 0.04);
  }

  .sidebar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.1rem 0.75rem;
    border-bottom: 1px solid #f1f5f9;
    background: #fafbfd;
  }

  .sidebar-title {
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #334155;
  }

  .sidebar-count {
    font-size: 0.75rem;
    font-weight: 700;
    color: #fff;
    background: #2563eb;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
  }

  .sidebar-search-box {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.9rem;
    border-bottom: 1px solid #f1f5f9;
    background: #ffffff;
    transition: background 0.15s ease;
  }

  .sidebar-search-box:focus-within {
    background: #eff6ff;
  }

  .sidebar-search-icon {
    color: #94a3b8;
    flex-shrink: 0;
    transition: color 0.15s ease;
  }

  .sidebar-search-box:focus-within .sidebar-search-icon {
    color: #2563eb;
  }

  .sidebar-search-input {
    width: 100%;
    border: none;
    outline: none;
    font-size: 0.8rem;
    color: #0f172a;
    background: transparent;
  }

  .sidebar-search-input::placeholder {
    color: #94a3b8;
  }

  .sidebar-tags-list {
    display: flex;
    flex-direction: column;
    max-height: 70vh;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: #e2e8f0 transparent;
  }

  .sidebar-tag-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.6rem 1.1rem;
    text-decoration: none;
    color: #475467;
    font-size: 0.85rem;
    font-weight: 600;
    border-bottom: 1px solid #f8fafc;
    transition: all 0.12s ease;
    gap: 0.5rem;
  }

  .sidebar-tag-row:last-child {
    border-bottom: none;
  }

  .sidebar-tag-row:hover {
    background: #eff6ff;
    color: #1d4ed8;
  }

  .sidebar-tag-row.active {
    background: #1d4ed8;
    color: #fff;
  }

  .sidebar-tag-row.active .sidebar-tag-num {
    background: rgba(255, 255, 255, 0.25);
    color: #fff;
  }

  .sidebar-tag-name {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sidebar-tag-num {
    font-size: 0.72rem;
    font-weight: 700;
    color: #2563eb;
    background: #dbeafe;
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    flex-shrink: 0;
  }

  /* ── Right main area ── */
  .tag-main {
    min-width: 0;
  }

  .tag-main-header {
    margin-bottom: 1.5rem;
  }

  .tag-back {
    font-size: 0.8rem;
    font-weight: 700;
    color: #64748b;
    text-decoration: none;
    display: inline-block;
    margin-bottom: 1rem;
    transition: color 0.15s;
  }

  .tag-back:hover { color: #2563eb; }

  .tag-hero-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .tag-h1 {
    font-size: 2.2rem;
    font-weight: 900;
    letter-spacing: -0.03em;
    color: #0f172a;
    margin: 0 0 0.35rem;
    line-height: 1.1;
  }

  .tag-hash {
    color: #2563eb;
  }

  .tag-sub {
    color: #64748b;
    font-size: 0.95rem;
    margin: 0;
  }

  /* ── Empty state ── */
  .tag-empty {
    text-align: center;
    padding: 3rem 2rem;
    background: #f8fafc;
    border: 1.5px dashed #e2e8f0;
    border-radius: 16px;
    color: #64748b;
  }

  .tag-empty-icon { font-size: 2rem; margin-bottom: 0.75rem; }
  .tag-empty a { color: #2563eb; font-weight: 600; text-decoration: none; }

  /* ── Posts list ── */
  .tag-posts-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .tag-card-item {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    background: #fff;
    border: 1.5px solid #e2e8f0;
    border-radius: 14px;
    padding: 1.4rem 1.6rem;
    color: #0f172a;
    transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 1px 6px rgba(15, 23, 42, 0.03);
  }

  .tag-card-item:hover {
    border-color: #93c5fd;
    box-shadow: 0 6px 20px rgba(37, 99, 235, 0.08);
  }

  .tag-card-top {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .post-cat {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    padding: 0.15rem 0.55rem;
    border-radius: 5px;
    border: 1px solid;
  }

  .post-domain {
    font-size: 0.78rem;
    color: #94a3b8;
    font-weight: 600;
  }

  .post-read {
    font-size: 0.75rem;
    color: #94a3b8;
    font-weight: 600;
    margin-left: auto;
  }

  .post-brand {
    font-size: 1.3rem;
    font-weight: 800;
    margin: 0;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .post-brand-link {
    color: #0f172a;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .post-brand-link:hover {
    color: #1d4ed8;
  }

  .post-tagline {
    font-size: 0.9rem;
    font-weight: 600;
    color: #334155;
    margin: 0;
    line-height: 1.35;
  }

  .post-desc {
    font-size: 0.86rem;
    color: #64748b;
    line-height: 1.55;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .tag-card-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-top: 0.5rem;
    margin-top: 0.25rem;
    border-top: 1px solid #f1f5f9;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  /* Real button style for tags */
  .post-tag {
    font-size: 0.78rem;
    font-weight: 700;
    padding: 0.32rem 0.75rem;
    border-radius: 6px;
    border: 1px solid #cbd5e1;
    background: #f8fafc;
    color: #1e293b;
    text-decoration: none;
    transition: all 0.15s cubic-bezier(0.16, 1, 0.3, 1);
    display: inline-flex;
    align-items: center;
    box-shadow: 0 1px 2px rgba(15, 23, 42, 0.05);
    cursor: pointer;
  }

  .post-tag:hover {
    background: #2563eb;
    border-color: #2563eb;
    color: #ffffff;
    transform: translateY(-1px);
    box-shadow: 0 3px 8px rgba(37, 99, 235, 0.25);
  }

  .post-tag:active {
    transform: translateY(0);
  }

  .post-tag-active {
    background: #1d4ed8;
    color: #ffffff;
    border-color: #1d4ed8;
    box-shadow: 0 2px 5px rgba(29, 78, 216, 0.3);
  }

  .post-tag-active:hover {
    background: #1e40af;
    border-color: #1e40af;
    color: #ffffff;
    box-shadow: 0 3px 8px rgba(30, 64, 175, 0.35);
  }

  .post-read-link {
    font-size: 0.85rem;
    font-weight: 700;
    color: #2563eb;
    text-decoration: none;
    transition: color 0.15s ease, transform 0.15s ease;
    display: inline-flex;
    align-items: center;
    margin-left: auto;
  }

  .post-read-link:hover {
    color: #1d4ed8;
    transform: translateX(2px);
  }

  /* mono helper */
  .mono { font-family: 'Courier New', Courier, monospace; }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    var searchInput = document.getElementById('sidebar-tag-search');
    var tagRows = document.querySelectorAll('#sidebar-tags-list .sidebar-tag-row');
    var countBadge = document.getElementById('sidebar-count');

    if (searchInput) {
      searchInput.addEventListener('input', function() {
        var query = (this.value || '').trim().toLowerCase().replace(/^#/, '');
        var visibleCount = 0;

        tagRows.forEach(function(row) {
          var tag = row.getAttribute('data-tag') || '';
          if (!query || tag.includes(query)) {
            row.style.display = 'flex';
            visibleCount++;
          } else {
            row.style.display = 'none';
          }
        });

        if (countBadge) {
          countBadge.textContent = visibleCount;
        }
      });
    }
  });
</script>
