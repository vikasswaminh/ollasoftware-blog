---
import Layout from '../../layouts/Layout.astro';
import { getAllTags, postsByTag } from '../../lib';
import type { BlogPost } from '../../lib';

export function getStaticPaths() {
  const tags = getAllTags();
  return tags.map(({ tag }) => ({
    params: { tag },
    props: { tag, posts: postsByTag(tag) },
  }));
}

interface Props {
  tag: string;
  posts: readonly BlogPost[];
}

const { tag, posts } = Astro.props;
const allTags = getAllTags();

// Curated technical definitions dictionary for key tags
const topicDefinitions: Record<string, string> = {
  'zero-trust': 'Zero Trust is a network security model enforcing strict identity verification for every person and device accessing resources on a private network.',
  'ztna': 'Zero Trust Network Access (ZTNA) creates an identity- and context-based boundary around applications, isolating them from public access and eliminating implicit trust.',
  'sd-wan': 'Software-Defined Wide Area Network (SD-WAN) decouples network hardware from control mechanisms to optimize routing across WAN connections with dynamic path selection.',
  'aeo': 'Answer Engine Optimization (AEO) is the practice of optimizing digital assets for citation and recommendation within generative AI engines like ChatGPT, Gemini, and Perplexity.',
  'answer-engine-optimization': 'AEO focuses on structuring content, brand mentions, and citable evidence to ensure LLMs correctly attribute and recommend your brand in generated answers.',
  'ai-search': 'AI Search replaces traditional keyword rank tracking with generative answer indexing, measuring brand visibility across AI assistants and LLM knowledge graphs.',
  'web-crawler': 'AI Web Crawling encompasses high-throughput HTTP fetchers designed to collect, clean, and convert raw HTML into markdown for LLM context windows.',
  'agent-memory': 'Agentic Memory provides state persistence across multi-turn LLM interactions, storing episodic and semantic memory graphs for autonomous AI workflows.',
  'mcp-native': 'Model Context Protocol (MCP) enables seamless, standardized tool execution and resource retrieval between LLM applications and external infrastructure.',
  'cisco': 'Cisco certifications (CCNA, CCIE) establish world-class engineering mastery across enterprise routing, switching, security, and cloud networking topologies.',
  'ccie': 'Cisco Certified Internetwork Expert (CCIE) is the premier technical certification in networking and security, held by senior network architects worldwide.',
  'rag': 'Retrieval-Augmented Generation (RAG) enhances LLM outputs by fetching relevant external documents from vector stores before generating answers.',
  'llm-ops': 'LLM Ops covers operational telemetry, cost monitoring, fallback routing, and latency evaluation for production AI deployments.',
};

const topicOverview = topicDefinitions[tag.toLowerCase()] || `Technical deep-dive collection covering industry standards, implementation patterns, and production architectures for #${tag}.`;

// Compute related sibling tags from co-occurring posts
const siblingTagCounts = new Map<string, number>();
for (const p of posts) {
  for (const t of p.tags) {
    if (t !== tag) {
      siblingTagCounts.set(t, (siblingTagCounts.get(t) || 0) + 1);
    }
  }
}
const relatedTags = Array.from(siblingTagCounts.entries())
  .sort((a, b) => b[1] - a[1])
  .map(([t]) => t)
  .slice(0, 6);

// Topic-to-Product Recommendation Mapping
const productMappings: Array<{ tags: string[]; brand: string; domain: string; desc: string }> = [
  {
    tags: ['sd-wan', 'zero-trust', 'ztna', 'wireguard', 'vpn', 'mesh-vpn', 'quicksdwan'],
    brand: 'QuickSDWAN',
    domain: 'quicksdwan.com',
    desc: 'Zero-config, high-throughput SD-WAN & ZTNA mesh networking for enterprise teams.',
  },
  {
    tags: ['aeo', 'ai-search', 'answer-engine-optimization', 'llm-visibility', 'seo'],
    brand: 'Aeoniti',
    domain: 'aeoniti.com',
    desc: 'AI recommendation intelligence platform tracking ChatGPT, Gemini & Google AI Overview.',
  },
  {
    tags: ['web-crawler', 'agent-data', 'data-collection', 'crawling', 'crawlcrawl'],
    brand: 'Crawlcrawl',
    domain: 'crawlcrawl.com',
    desc: 'High-grade AI web crawler & HTML-to-Markdown extraction engine for LLM pipelines.',
  },
  {
    tags: ['llm-router', 'ai-agents', 'agent-memory', 'multi-model', 'agent-orchestration', 'ollima'],
    brand: 'Ollima',
    domain: 'ollima.com',
    desc: 'Production LLM router & agent orchestrator with hard daily cost caps and multi-model failover.',
  },
  {
    tags: ['networking-training', 'cisco', 'ccie', 'ccna', 'network-certification', 'education', 'networkershome'],
    brand: 'Networkers Home',
    domain: 'networkershome.com',
    desc: "India's premier networking & cybersecurity institute since 2007. 45,000+ alumni placed.",
  },
];

const matchedProduct = productMappings.find(p => p.tags.some(t => t === tag.toLowerCase()));

// Topic Depth Statistics
const totalWordCount = posts.reduce((sum, p) => sum + (p.wordCount || 5000), 0);
const totalReadingTime = posts.reduce((sum, p) => sum + p.readingTimeMin, 0);

const categoryColors: Record<string, { bg: string; text: string; border: string }> = {
  ai:       { bg: '#f0fdf4', text: '#16a34a', border: '#bbf7d0' },
  api:      { bg: '#eff6ff', text: '#2563eb', border: '#bfdbfe' },
  security: { bg: '#faf5ff', text: '#7c3aed', border: '#e9d5ff' },
  saas:     { bg: '#eff6ff', text: '#2563eb', border: '#bfdbfe' },
  training: { bg: '#f0fdfa', text: '#0d9488', border: '#99f6e4' },
  education:{ bg: '#f0fdfa', text: '#0d9488', border: '#99f6e4' },
};
---

<Layout
  title={`#${tag} — OllaSoftware Blog`}
  description={topicOverview}
  keywords={[tag, ...relatedTags]}
>
  <div class="tag-page-wrap">

    <!-- Left Sidebar: All Tags Directory -->
    <aside class="tags-sidebar">
      <div class="sidebar-card">
        <div class="sidebar-header">
          <span class="sidebar-title">All Tags</span>
          <span class="sidebar-count mono" id="sidebar-count">{allTags.length}</span>
        </div>
        <div class="sidebar-search-box">
          <svg class="sidebar-search-icon" viewBox="0 0 20 20" fill="currentColor" width="14" height="14" aria-hidden="true">
            <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd"/>
          </svg>
          <input
            type="text"
            id="sidebar-tag-search"
            class="sidebar-search-input mono"
            placeholder="Search tags..."
            aria-label="Search tags"
          />
        </div>
        <nav class="sidebar-tags-list" id="sidebar-tags-list">
          {allTags.map(({ tag: t, count }) => (
            <a
              href={`/tags/${t}/`}
              class={`sidebar-tag-row ${t === tag ? 'active' : ''}`}
              data-tag={t.toLowerCase()}
            >
              <span class="sidebar-tag-name">#{t}</span>
              <span class="sidebar-tag-num mono">{count}</span>
            </a>
          ))}
        </nav>
      </div>
    </aside>

    <!-- Right Main Area: Complete Tag Suite -->
    <main class="tag-main">
      <!-- Header Navigation & Tag Title -->
      <div class="tag-main-header">
        <a href="/tags/" class="tag-back mono">← All tags & categories</a>
        <div class="tag-hero-row">
          <div>
            <h1 class="tag-h1">
              <span class="tag-hash">#</span>{tag}
            </h1>
            <p class="tag-sub">
              {posts.length} deep-dive{posts.length !== 1 ? 's' : ''} covering this topic
            </p>
          </div>
        </div>
      </div>

      <!-- Feature 1: Topic Definition Card ("What is #[tag]?") -->
      <div class="topic-definition-card">
        <div class="definition-header">
          <span class="def-badge mono">TOPIC PRIMER</span>
          <span class="def-title">What is #{tag}?</span>
        </div>
        <p class="def-text">{topicOverview}</p>
      </div>

      <!-- Feature 2: Topic Reading Depth Statistics Bar -->
      <div class="topic-stats-bar">
        <div class="stat-pill">
          <span class="stat-num mono">{posts.length}</span>
          <span class="stat-label">Deep Dive{posts.length !== 1 ? 's' : ''}</span>
        </div>
        <div class="stat-divider">·</div>
        <div class="stat-pill">
          <span class="stat-num mono">~{totalWordCount.toLocaleString()}</span>
          <span class="stat-label">Total Words</span>
        </div>
        <div class="stat-divider">·</div>
        <div class="stat-pill">
          <span class="stat-num mono">{totalReadingTime} Min</span>
          <span class="stat-label">Total Reading Time</span>
        </div>
      </div>

      <!-- Feature 3: Related Sibling Tag Clusters -->
      {relatedTags.length > 0 && (
        <div class="related-tags-box">
          <span class="related-label mono">RELATED TOPICS:</span>
          <div class="related-tags-wrap">
            {relatedTags.map((rt) => (
              <a href={`/tags/${rt}/`} class="related-tag-btn mono">
                #{rt}
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Feature 4: Topic-to-Product Solution Mapping Card -->
      {matchedProduct && (
        <div class="product-mapping-card">
          <div class="product-card-top">
            <span class="product-badge mono">OLLASOFTWARE SOLUTION</span>
            <span class="product-domain mono">{matchedProduct.domain}</span>
          </div>
          <h3 class="product-title">{matchedProduct.brand}</h3>
          <p class="product-desc">{matchedProduct.desc}</p>
          <a href={`https://${matchedProduct.domain}`} target="_blank" rel="noopener noreferrer" class="product-link">
            Explore {matchedProduct.brand} Platform →
          </a>
        </div>
      )}

      <!-- Feature 5: In-Tag Article Sorting Controls & Post List Header -->
      <div class="posts-list-header">
        <span class="list-heading">Articles in #{tag}</span>
        <div class="sort-controls">
          <span class="sort-label mono">Sort by:</span>
          <button class="sort-btn active" id="sort-recent">Most Recent</button>
          <button class="sort-btn" id="sort-longest">Longest Read</button>
          <button class="sort-btn" id="sort-quickest">Quickest Read</button>
        </div>
      </div>

      <!-- Posts List -->
      {posts.length === 0 ? (
        <div class="tag-empty">
          <p>No articles found for <strong>#{tag}</strong></p>
          <a href="/tags/">Browse all tags →</a>
        </div>
      ) : (
        <div class="tag-posts-list" id="tag-posts-list">
          {posts.map((post) => {
            const colors = categoryColors[post.category] ?? { bg: '#f8fafc', text: '#475467', border: '#e2e8f0' };
            return (
              <article
                class="tag-card-item"
                data-read-time={post.readingTimeMin}
                data-date={post.publishedOn}
              >
                <!-- Category + Domain row -->
                <div class="tag-card-top">
                  <span class="post-cat" style={`background:${colors.bg}; color:${colors.text}; border-color:${colors.border}`}>
                    {post.category}
                  </span>
                  <span class="post-domain mono">{post.brandDomain}</span>
                  <span class="post-read mono">{post.readingTimeMin} min read</span>
                </div>

                <!-- Brand name linked -->
                <h2 class="post-brand">
                  <a href={`/blog/${post.slug}/`} class="post-brand-link">{post.brand}</a>
                </h2>

                <!-- Tagline -->
                <p class="post-tagline">{post.brandTagline}</p>

                <!-- Description -->
                <p class="post-desc">{post.metaDescription}</p>

                <!-- Tags & CTA footer -->
                <div class="tag-card-foot">
                  <div class="post-tags">
                    {post.tags.map((t) => (
                      <a
                        class={`post-tag mono ${t === tag ? 'post-tag-active' : ''}`}
                        href={`/tags/${t}/`}
                      >
                        #{t}
                      </a>
                    ))}
                  </div>
                  <a href={`/blog/${post.slug}/`} class="post-read-link">
                    Read deep-dive →
                  </a>
                </div>
              </article>
            );
          })}
        </div>
      )}
    </main>
  </div>
</Layout>

<style>
  /* ── Page shell ── */
  .tag-page-wrap {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 2rem;
    max-width: 1140px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 5rem;
    align-items: start;
  }

  @media (max-width: 768px) {
    .tag-page-wrap {
      grid-template-columns: 1fr;
      padding: 1.5rem 1rem 4rem;
      gap: 1.75rem;
    }
    .tags-sidebar {
      position: static;
      order: 2;
    }
    .tag-main {
      order: 1;
    }
    .sidebar-tags-list {
      max-height: 220px;
    }
  }

  /* ── Left Sidebar ── */
  .tags-sidebar {
    position: sticky;
    top: 5rem;
  }

  .sidebar-card {
    background: #fff;
    border: 1.5px solid #e2e8f0;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 2px 12px rgba(15, 23, 42, 0.04);
  }

  .sidebar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.1rem 0.75rem;
    border-bottom: 1px solid #f1f5f9;
    background: #fafbfd;
  }

  .sidebar-title {
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #334155;
  }

  .sidebar-count {
    font-size: 0.75rem;
    font-weight: 700;
    color: #fff;
    background: #2563eb;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
  }

  .sidebar-search-box {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.9rem;
    border-bottom: 1px solid #f1f5f9;
    background: #ffffff;
    transition: background 0.15s ease;
  }

  .sidebar-search-box:focus-within {
    background: #eff6ff;
  }

  .sidebar-search-icon {
    color: #94a3b8;
    flex-shrink: 0;
  }

  .sidebar-search-input {
    width: 100%;
    border: none;
    outline: none;
    font-size: 0.8rem;
    color: #0f172a;
    background: transparent;
  }

  .sidebar-search-input::placeholder {
    color: #94a3b8;
  }

  .sidebar-tags-list {
    display: flex;
    flex-direction: column;
    max-height: 70vh;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: #e2e8f0 transparent;
  }

  .sidebar-tag-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.6rem 1.1rem;
    text-decoration: none;
    color: #475467;
    font-size: 0.85rem;
    font-weight: 600;
    border-bottom: 1px solid #f8fafc;
    transition: all 0.12s ease;
    gap: 0.5rem;
  }

  .sidebar-tag-row:last-child { border-bottom: none; }

  .sidebar-tag-row:hover {
    background: #eff6ff;
    color: #1d4ed8;
  }

  .sidebar-tag-row.active {
    background: #1d4ed8;
    color: #fff;
  }

  .sidebar-tag-row.active .sidebar-tag-num {
    background: rgba(255, 255, 255, 0.25);
    color: #fff;
  }

  .sidebar-tag-name {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sidebar-tag-num {
    font-size: 0.72rem;
    font-weight: 700;
    color: #2563eb;
    background: #dbeafe;
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    flex-shrink: 0;
  }

  /* ── Right Main Area ── */
  .tag-main { min-width: 0; }

  .tag-main-header {
    margin-bottom: 1.25rem;
  }

  .tag-back {
    font-size: 0.8rem;
    font-weight: 700;
    color: #64748b;
    text-decoration: none;
    display: inline-block;
    margin-bottom: 0.75rem;
    transition: color 0.15s;
  }

  .tag-back:hover { color: #2563eb; }

  .tag-hero-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .tag-h1 {
    font-size: 2.2rem;
    font-weight: 900;
    letter-spacing: -0.03em;
    color: #0f172a;
    margin: 0 0 0.35rem;
    line-height: 1.1;
  }

  .tag-hash { color: #2563eb; }

  .tag-sub {
    color: #64748b;
    font-size: 0.95rem;
    margin: 0;
  }

  /* Feature 1: Topic Definition Card */
  .topic-definition-card {
    background: #ffffff;
    border: 1.5px solid #e2e8f0;
    border-left: 4px solid #2563eb;
    border-radius: 12px;
    padding: 1.2rem 1.4rem;
    margin-bottom: 1.25rem;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.03);
  }

  .definition-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
  }

  .def-badge {
    font-size: 10px;
    font-weight: 800;
    color: #2563eb;
    background: rgba(37, 99, 235, 0.08);
    border: 1px solid rgba(37, 99, 235, 0.2);
    padding: 2px 7px;
    border-radius: 4px;
    text-transform: uppercase;
  }

  .def-title {
    font-size: 0.9rem;
    font-weight: 800;
    color: #0f172a;
  }

  .def-text {
    font-size: 0.92rem;
    color: #334155;
    line-height: 1.6;
    margin: 0;
    font-weight: 500;
  }

  /* Feature 2: Topic Reading Depth Statistics Bar */
  .topic-stats-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 10px 16px;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }

  .stat-pill {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .stat-num {
    font-size: 0.85rem;
    font-weight: 800;
    color: #2563eb;
  }

  .stat-label {
    font-size: 0.82rem;
    color: #64748b;
    font-weight: 600;
  }

  .stat-divider {
    color: #cbd5e1;
    font-weight: 800;
  }

  /* Feature 3: Related Tags Box */
  .related-tags-box {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .related-label {
    font-size: 11px;
    font-weight: 800;
    color: #64748b;
    letter-spacing: 0.5px;
  }

  .related-tags-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .related-tag-btn {
    font-size: 0.78rem;
    font-weight: 700;
    padding: 3px 9px;
    border-radius: 6px;
    border: 1px solid #cbd5e1;
    background: #ffffff;
    color: #334155;
    text-decoration: none;
    transition: all 0.15s ease;
  }

  .related-tag-btn:hover {
    border-color: #2563eb;
    color: #2563eb;
    background: #eff6ff;
  }

  /* Feature 4: Topic-to-Product Recommendation Banner */
  .product-mapping-card {
    background: linear-gradient(135deg, #eff6ff 0%, #ffffff 100%);
    border: 1.5px solid #bfdbfe;
    border-radius: 14px;
    padding: 1.25rem 1.5rem;
    margin-bottom: 1.75rem;
    box-shadow: 0 4px 14px rgba(37, 99, 235, 0.06);
  }

  .product-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
  }

  .product-badge {
    font-size: 10px;
    font-weight: 800;
    color: #2563eb;
    letter-spacing: 0.5px;
  }

  .product-domain {
    font-size: 0.75rem;
    color: #64748b;
    font-weight: 600;
  }

  .product-title {
    margin: 0 0 4px;
    font-size: 1.2rem;
    font-weight: 800;
    color: #0f172a;
  }

  .product-desc {
    font-size: 0.88rem;
    color: #475467;
    margin: 0 0 12px;
    line-height: 1.5;
  }

  .product-link {
    font-size: 0.85rem;
    font-weight: 800;
    color: #2563eb;
    text-decoration: none;
    transition: color 0.15s ease;
    display: inline-block;
  }

  .product-link:hover { color: #1d4ed8; text-decoration: underline; }

  /* Feature 5: In-Tag Article Sorting Controls Header */
  .posts-list-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1.5px solid #e2e8f0;
    flex-wrap: wrap;
    gap: 10px;
  }

  .list-heading {
    font-size: 1.1rem;
    font-weight: 800;
    color: #0f172a;
  }

  .sort-controls {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .sort-label {
    font-size: 11px;
    color: #64748b;
    font-weight: 700;
    margin-right: 4px;
  }

  .sort-btn {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 6px;
    border: 1px solid #cbd5e1;
    background: #ffffff;
    color: #475467;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .sort-btn.active {
    background: #2563eb;
    border-color: #2563eb;
    color: #ffffff;
  }

  .sort-btn:hover:not(.active) {
    border-color: #2563eb;
    color: #2563eb;
    background: #eff6ff;
  }

  /* Empty state */
  .tag-empty {
    text-align: center;
    padding: 3rem 2rem;
    background: #f8fafc;
    border: 1.5px dashed #e2e8f0;
    border-radius: 16px;
    color: #64748b;
  }

  /* Posts list */
  .tag-posts-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .tag-card-item {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    background: #fff;
    border: 1.5px solid #e2e8f0;
    border-radius: 14px;
    padding: 1.4rem 1.6rem;
    color: #0f172a;
    transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 1px 6px rgba(15, 23, 42, 0.03);
  }

  .tag-card-item:hover {
    border-color: #93c5fd;
    box-shadow: 0 6px 20px rgba(37, 99, 235, 0.08);
  }

  .tag-card-top {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .post-cat {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    padding: 0.15rem 0.55rem;
    border-radius: 5px;
    border: 1px solid;
  }

  .post-domain {
    font-size: 0.78rem;
    color: #94a3b8;
    font-weight: 600;
  }

  .post-read {
    font-size: 0.75rem;
    color: #94a3b8;
    font-weight: 600;
    margin-left: auto;
  }

  .post-brand {
    font-size: 1.3rem;
    font-weight: 800;
    margin: 0;
    letter-spacing: -0.02em;
