---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTags, allPosts } from '../../lib';

const allTags = getAllTags();

// Category definitions with rich metadata, clean taglines, and tag mapping rules (No emojis/images)
const categories = [
  {
    id: 'ai',
    name: 'AI & Intelligent Agents',
    tagline: 'AEO, LLM Observability, RAG, Web Memory & Agentic Runtimes',
    color: { bg: '#f0fdf4', border: '#bbf7d0', text: '#15803d', accent: '#16a34a' },
    keywords: ['ai', 'aeo', 'agent', 'llm', 'rag', 'web-memory', 'crawling', 'graph', 'vector', 'multi-model', 'production-ai', 'enterprise-ai', 'answer-engine', 'seo', 'privacy'],
  },
  {
    id: 'security',
    name: 'Security & Networking',
    tagline: 'Zero Trust, SD-WAN, Mesh VPN, WireGuard & Quantum Security',
    color: { bg: '#faf5ff', border: '#e9d5ff', text: '#6b21a8', accent: '#7c3aed' },
    keywords: ['security', 'zero-trust', 'ztna', 'sd-wan', 'vpn', 'wireguard', 'encryption', 'phishing', 'dns', 'quantum', 'network-security', 'secure-access', 'remote-access'],
  },
  {
    id: 'api',
    name: 'APIs & Infrastructure',
    tagline: 'Localhost Tunnels, MCP Native, Realtime Data Sync & Edge Compute',
    color: { bg: '#eff6ff', border: '#bfdbfe', text: '#1d4ed8', accent: '#2563eb' },
    keywords: ['api', 'tunnel', 'mcp', 'sync', 'edge', 'infra', 'media', 'cdn', 'reliability', 'cross-platform', 'data-sync', 'localhost-tunnel', 'secure-tunneling'],
  },
  {
    id: 'saas',
    name: 'SaaS & Developer Tools',
    tagline: 'Resume Builders, SaaS Infrastructure & Indian Developer Ecosystems',
    color: { bg: '#fff7ed', border: '#fed7aa', text: '#c2410c', accent: '#ea580c' },
    keywords: ['saas', 'resume', 'free-tool', 'cv', 'career', 'indian-developers', 'rupee', 'developer-tools', 'career-tools', 'distributed-teams'],
  },
  {
    id: 'education',
    name: 'Education & Certifications',
    tagline: 'Cisco Training, CCNA/CCIE Bootcamps & Enterprise Networking Education',
    color: { bg: '#f0fdfa', border: '#99f6e4', text: '#0f766e', accent: '#0d9488' },
    keywords: ['education', 'cisco', 'ccna', 'ccie', 'networking-training', 'certification', 'exam', 'bangalore', 'exam-prep', 'networkershome'],
  },
];

function getCategoryForTag(tag: string): string {
  const t = tag.toLowerCase();
  for (const cat of categories) {
    if (cat.keywords.some(kw => t.includes(kw))) {
      return cat.id;
    }
  }
  return 'ai';
}

const categorizedTags = categories.map((cat) => {
  const tagsInCat = allTags.filter((t) => getCategoryForTag(t.tag) === cat.id);
  const totalPosts = tagsInCat.reduce((acc, curr) => acc + curr.count, 0);
  return {
    ...cat,
    tags: tagsInCat,
    totalPosts,
  };
});
---

<BaseLayout
  title="Tags & Category — OllaSoftware Blog"
  description={`Explore all ${allTags.length} topics categorized into 5 technology pillars across ${allPosts.length} brand deep-dives.`}
  fullWidth={true}
>
  <!-- Hero Section matching the exact background & style of the main blog page -->
  <section slot="hero" class="hero-section">
    <div class="hero-content">
      <div class="eyebrow-badge mono">PRO TOPIC TAXONOMY</div>
      <h1 class="hero-title">
        Tags & <span class="hero-title-blog">Category</span>
      </h1>
      <p class="hero-tagline">
        Explore {allTags.length} topics categorized into 5 technology pillars across {allPosts.length} brand deep-dives. Select any category or tag below to filter articles instantly.
      </p>

      <!-- Sleek Search Bar matching the main blog page -->
      <div class="search-container">
        <form class="search-form" id="search-form" onsubmit="event.preventDefault();">
          <div class="search-input-wrapper">
            <svg
              class="search-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input
              type="text"
              id="hub-search-input"
              class="search-input"
              placeholder="Search topics (e.g. zero-trust, ai-agents, cisco, mcp)..."
              autocomplete="off"
              aria-label="Search topics"
            />
          </div>
          <button type="button" id="clear-btn" class="search-clear-btn" style="display: none;" aria-label="Clear search">
            ✕ Clear
          </button>
        </form>
      </div>

      <!-- Category Filter Tabs (Text-Only, No Emojis/Images) -->
      <nav class="category-tabs-bar" aria-label="Category Filters">
        <button class="cat-tab-btn active" data-cat="all">
          All Categories
          <span class="cat-tab-count mono">{allTags.length}</span>
        </button>
        {categorizedTags.map((cat) => (
          <button class="cat-tab-btn" data-cat={cat.id}>
            {cat.name}
            <span class="cat-tab-count mono">{cat.tags.length}</span>
          </button>
        ))}
      </nav>
    </div>
  </section>

  <!-- Main Content Area -->
  <div class="tags-hub-body">
    <div class="container">

      <!-- Dynamic Search No Results State -->
      <div id="no-results-box" class="no-results-box" style="display: none;">
        <h3>No matching topics found</h3>
        <p>Try searching for terms like <code>zero-trust</code>, <code>aeo</code>, <code>api</code>, or <code>cisco</code>.</p>
      </div>

      <!-- Categorized Sections -->
      <div class="categories-list" id="categories-list">
        {categorizedTags.map((cat) => (
          <section class="category-card-block" data-cat-block={cat.id}>
            <div class="category-card-header" style={`background: ${cat.color.bg}; border-color: ${cat.color.border}`}>
              <div class="cat-header-left">
                <h2 class="cat-title" style={`color: ${cat.color.text}`}>{cat.name}</h2>
                <p class="cat-tagline">{cat.tagline}</p>
              </div>
              <div class="cat-header-right">
                <span class="cat-badge mono" style={`background: ${cat.color.border}; color: ${cat.color.text}`}>
                  {cat.tags.length} topics · {cat.totalPosts} posts
                </span>
              </div>
            </div>

            <!-- Tags Grid within Category -->
            <div class="category-tags-grid">
              {cat.tags.map(({ tag, count }) => (
                <a
                  href={`/tags/${tag}/`}
                  class="tag-pill-item"
                  data-tag-name={tag.toLowerCase()}
                  title={`View articles tagged #${tag}`}
                >
                  <span class="tag-hash" style={`color: ${cat.color.text}`}>#</span>
                  <span class="tag-label">{tag}</span>
                  <span class="tag-count-badge mono">{count}</span>
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>

      <!-- Quick Index of All Tags -->
      <section class="all-tags-section" id="all-tags-section">
        <div class="all-tags-header">
          <span class="section-badge mono">COMPLETE DIRECTORY</span>
          <h2>All Topics Directory ({allTags.length})</h2>
          <p>Alphabetical index of all blog tags across the site</p>
        </div>
        <div class="all-tags-grid" id="all-tags-grid">
          {allTags.map(({ tag, count }) => (
            <a href={`/tags/${tag}/`} class="all-tag-card" data-tag-card={tag.toLowerCase()}>
              <span class="all-tag-hash">#</span>
              <span class="all-tag-name">{tag}</span>
              <span class="all-tag-num mono">{count}</span>
            </a>
          ))}
        </div>
      </section>

    </div>
  </div>
</BaseLayout>

<style>
  /* ── Page Shell ── */
  .tags-hub-body {
    background: var(--bg, #f4f7fb);
    padding: 3rem 0 5rem;
    min-height: 60vh;
  }

  /* ── Hero Section (Matching Main Blog Page Background) ── */
  .hero-section {
    width: 100%;
    background-color: #f8fafc;
    background-image: url('/hero-bg.png');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    text-align: center;
    padding: 3.5rem 1.5rem 3rem;
    border-bottom: 1.5px solid var(--border, #e2e8f0);
    box-shadow: 0 4px 20px rgba(15, 23, 42, 0.03);
    position: relative;
    overflow: hidden;
  }

  /* High-tech Blueprint Grid overlay matching main blog hero */
  .hero-section::before {
    content: "";
    position: absolute;
    inset: 0;
    background-size: 32px 32px;
    background-image: 
      linear-gradient(to right, rgba(29, 106, 243, 0.08) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(29, 106, 243, 0.08) 1px, transparent 1px);
    mask-image: radial-gradient(ellipse 80% 70% at 50% 50%, #000 30%, transparent 95%);
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 50%, #000 30%, transparent 95%);
    pointer-events: none;
    z-index: 1;
  }

  .hero-content {
    max-width: 46rem;
    margin: 0 auto;
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .eyebrow-badge {
    background: rgba(37, 99, 235, 0.08);
    color: #1d4ed8;
    border: 1px solid rgba(37, 99, 235, 0.25);
    padding: 3px 12px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 1rem;
    display: inline-block;
  }

  .hero-title {
    font-family: 'Lato', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    font-size: 2.75rem;
    line-height: 1.16;
    font-weight: 900;
    color: #0f172a;
    margin: 0 0 0.85rem;
    letter-spacing: -0.03em;
  }

  .hero-title-blog {
    color: #1D6AF3;
  }

  /* Subtitle formatted strictly in Lato font */
  .hero-tagline {
    font-family: 'Lato', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    color: #475467;
    font-size: 1.12rem;
    line-height: 1.6;
    margin: 0 auto 2rem;
    max-width: 42rem;
    text-align: center;
    font-weight: 500;
  }

  /* ── Sleek Search Container matching Blog Page ── */
  .search-container {
    width: 100%;
    max-width: 44rem;
    margin: 0 auto 2.25rem;
  }

  .search-form {
    display: flex;
    align-items: center;
    background: #ffffff;
    border: 1.5px solid #cbd5e1;
    border-radius: var(--radius-full, 9999px);
    padding: 6px 7px 6px 20px;
    box-shadow: 0 4px 20px rgba(15, 23, 42, 0.06), 0 1px 3px rgba(15, 23, 42, 0.04);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    gap: 10px;
  }

  .search-form:focus-within {
    border-color: #2563eb;
    background: #ffffff;
    box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.12), 0 12px 32px rgba(37, 99, 235, 0.08);
    transform: translateY(-1px);
  }

  .search-input-wrapper {
    display: flex;
    align-items: center;
    flex: 1;
    gap: 12px;
  }

  .search-icon {
    width: 20px;
    height: 20px;
    color: #64748b;
    flex-shrink: 0;
    transition: color 0.2s ease;
  }

  .search-form:focus-within .search-icon {
    color: #2563eb;
  }

  .search-input {
    width: 100%;
    border: none;
    outline: none;
    font-family: 'Lato', sans-serif;
    font-size: 1rem;
    color: #0f172a;
    background: transparent;
    padding: 6px 0;
  }

  .search-input::placeholder {
    color: #94a3b8;
  }

  .search-clear-btn {
    background: #f1f5f9;
    border: none;
    color: #64748b;
    font-family: 'Lato', sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 9999px;
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .search-clear-btn:hover {
    background: #e2e8f0;
    color: #0f172a;
  }

  /* ── Category Filter Tabs (Clean text-only) ── */
  .category-tabs-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    max-width: 44rem;
  }

  .cat-tab-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 16px;
    border-radius: 9999px;
    border: 1.5px solid #cbd5e1;
    background: #ffffff;
    color: #334155;
    font-family: 'Lato', sans-serif;
    font-size: 0.88rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04);
  }

  .cat-tab-btn:hover {
    border-color: #2563eb;
    color: #1d4ed8;
    background: #eff6ff;
    transform: translateY(-1px);
  }

  .cat-tab-btn.active {
    background: #1d4ed8;
    border-color: #1d4ed8;
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(29, 78, 216, 0.28);
  }

  .cat-tab-count {
    font-size: 0.72rem;
    font-weight: 800;
    padding: 2px 7px;
    border-radius: 9999px;
    background: #f1f5f9;
    color: #475467;
  }

  .cat-tab-btn.active .cat-tab-count {
    background: rgba(255, 255, 255, 0.25);
    color: #ffffff;
  }

  /* ── Main Body & Cards ── */
  .no-results-box {
    text-align: center;
    padding: 3rem 2rem;
    background: #ffffff;
    border: 2px dashed #cbd5e1;
    border-radius: 16px;
    color: #475467;
    margin-bottom: 3rem;
  }

  .no-results-box h3 {
    margin: 0 0 0.5rem;
    color: #0f172a;
    font-size: 1.25rem;
    font-family: 'Lato', sans-serif;
  }

  .no-results-box code {
    background: #f1f5f9;
    padding: 2px 6px;
    border-radius: 4px;
    color: #1d4ed8;
  }

  .categories-list {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
    margin-bottom: 4rem;
  }

  .category-card-block {
    background: #ffffff;
    border: 1.5px solid #e2e8f0;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.03);
    transition: all 0.2s ease;
  }

  .category-card-block:hover {
    border-color: #cbd5e1;
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.06);
  }

  .category-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    flex-wrap: wrap;
    gap: 12px;
  }

  .cat-header-left {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .cat-title {
    margin: 0;
    font-family: 'Lato', sans-serif;
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .cat-tagline {
    margin: 0;
    font-family: 'Lato', sans-serif;
    font-size: 0.88rem;
    color: #475467;
    font-weight: 500;
  }

  .cat-badge {
    font-size: 0.72rem;
    font-weight: 800;
    padding: 4px 10px;
    border-radius: 6px;
    letter-spacing: 0.03em;
  }

  .category-tags-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 12px;
    padding: 1.5rem;
  }

  .tag-pill-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 9px 14px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    text-decoration: none;
    color: #1e293b;
    font-family: 'Lato', sans-serif;
    font-size: 0.9rem;
    font-weight: 700;
    transition: all 0.16s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tag-pill-item:hover {
    background: #ffffff;
    border-color: #2563eb;
    color: #1d4ed8;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.12);
  }

  .tag-hash {
    font-weight: 900;
    font-size: 0.95rem;
  }

  .tag-label {
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .tag-count-badge {
    font-size: 0.72rem;
    font-weight: 800;
    color: #475467;
    background: #e2e8f0;
    padding: 2px 7px;
    border-radius: 9999px;
  }

  .tag-pill-item:hover .tag-count-badge {
    background: #2563eb;
    color: #ffffff;
  }

  /* ── All Tags Directory Section ── */
  .all-tags-section {
    border-top: 2px dashed #e2e8f0;
    padding-top: 3rem;
  }

  .all-tags-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .section-badge {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #64748b;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    padding: 3px 10px;
    border-radius: 5px;
    text-transform: uppercase;
  }

  .all-tags-header h2 {
    font-family: 'Lato', sans-serif;
    font-size: 1.75rem;
    font-weight: 900;
    color: #0f172a;
    margin: 8px 0 4px;
    letter-spacing: -0.02em;
  }

  .all-tags-header p {
    color: #64748b;
    font-size: 0.92rem;
    margin: 0;
  }

  .all-tags-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
    gap: 10px;
  }

  .all-tag-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    padding: 8px 12px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    text-decoration: none;
    color: #334155;
    font-family: 'Lato', sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    transition: all 0.15s ease;
  }

  .all-tag-card:hover {
    border-color: #2563eb;
    color: #1d4ed8;
    background: #eff6ff;
    transform: translateY(-1px);
  }

  .all-tag-hash {
    color: #2563eb;
    font-weight: 900;
  }

  .all-tag-name {
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .all-tag-num {
    font-size: 0.7rem;
    font-weight: 800;
    color: #2563eb;
    background: #dbeafe;
    padding: 1px 6px;
    border-radius: 9999px;
  }

  .mono {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  }

  @media (max-width: 768px) {
    .hero-section {
      padding: 2.5rem 1rem 2rem;
    }
    .hero-title {
      font-size: 2rem;
    }
    .hero-tagline {
      font-size: 1rem;
    }
    .category-tabs-bar {
      gap: 6px;
    }
    .cat-tab-btn {
      padding: 6px 12px;
      font-size: 0.8rem;
    }
    .category-tags-grid {
      grid-template-columns: 1fr;
      padding: 1rem;
    }
    .all-tags-grid {
      grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    var searchInput = document.getElementById('hub-search-input');
    var clearBtn = document.getElementById('clear-btn');
    var catTabs = document.querySelectorAll('.cat-tab-btn');
    var catBlocks = document.querySelectorAll('.category-card-block');
    var allTagCards = document.querySelectorAll('.all-tag-card');
    var noResults = document.getElementById('no-results-box');

    var activeCat = 'all';

    function filterHub() {
      var query = (searchInput ? searchInput.value : '').trim().toLowerCase().replace(/^#/, '');

      if (clearBtn) {
        clearBtn.style.display = query.length > 0 ? 'inline-flex' : 'none';
      }

      var totalVisibleTags = 0;

      catBlocks.forEach(function(block) {
        var catId = block.getAttribute('data-cat-block');
        var isCatMatch = activeCat === 'all' || activeCat === catId;

        var blockTagPills = block.querySelectorAll('.tag-pill-item');
        var visibleInBlock = 0;

        blockTagPills.forEach(function(pill) {
          var tagName = pill.getAttribute('data-tag-name') || '';
          var isTagMatch = !query || tagName.includes(query);

          if (isCatMatch && isTagMatch) {
            pill.style.display = 'flex';
            visibleInBlock++;
            totalVisibleTags++;
          } else {
            pill.style.display = 'none';
          }
        });

        if (isCatMatch && visibleInBlock > 0) {
          block.style.display = 'block';
        } else {
          block.style.display = 'none';
        }
      });

      // Filter all tags index grid
      allTagCards.forEach(function(card) {
        var tagName = card.getAttribute('data-tag-card') || '';
        if (!query || tagName.includes(query)) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });

      if (noResults) {
        noResults.style.display = totalVisibleTags === 0 ? 'block' : 'none';
      }
    }

    // Category Tabs click handler
    catTabs.forEach(function(tab) {
      tab.addEventListener('click', function() {
        catTabs.forEach(function(t) { t.classList.remove('active'); });
        this.classList.add('active');
        activeCat = this.getAttribute('data-cat') || 'all';
        filterHub();
      });
    });

    // Search Input listener
    if (searchInput) {
      searchInput.addEventListener('input', filterHub);
    }

    if (clearBtn) {
      clearBtn.addEventListener('click', function() {
        if (searchInput) searchInput.value = '';
        filterHub();
        if (searchInput) searchInput.focus();
      });
    }
  });
</script>
