---
import Layout from '../../layouts/Layout.astro';
import { getAllTags, allPosts } from '../../lib';

const allTags = getAllTags();
---

<Layout title="Tags — OllaSoftware Blog" description={`Browse all ${allTags.length} topics across ${allPosts.length} brand deep-dives.`}>
  <div class="tags-page-wrap">

    <!-- Left Sidebar -->
    <aside class="tags-sidebar">
      <div class="sidebar-card">
        <div class="sidebar-header">
          <span class="sidebar-title">All Tags</span>
          <span class="sidebar-count mono" id="sidebar-count">{allTags.length}</span>
        </div>
        <div class="sidebar-search-box">
          <svg class="sidebar-search-icon" viewBox="0 0 20 20" fill="currentColor" width="14" height="14" aria-hidden="true">
            <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd"/>
          </svg>
          <input
            type="text"
            id="sidebar-tag-search"
            class="sidebar-search-input mono"
            placeholder="Search tags..."
            aria-label="Search tags"
          />
        </div>
        <nav class="sidebar-tags-list" id="sidebar-tags-list">
          {allTags.map(({ tag, count }) => (
            <a href={`/tags/${tag}/`} class="sidebar-tag-row" data-tag={tag.toLowerCase()}>
              <span class="sidebar-tag-name">#{tag}</span>
              <span class="sidebar-tag-num mono">{count}</span>
            </a>
          ))}
        </nav>
      </div>
    </aside>

    <!-- Right: Welcome / Search & Grid -->
    <main class="tags-main">
      <div class="tags-hero">
        <p class="tags-eyebrow mono">BROWSE BY TOPIC</p>
        <h1 class="tags-h1">All Tags</h1>
        <p class="tags-sub">
          {allTags.length} topics across {allPosts.length} brand deep-dives —
          every tag is real, derived directly from post content.
        </p>

        <!-- Main Search Bar -->
        <div class="tags-search-wrap">
          <div class="tags-search-input-box">
            <svg class="tags-search-svg" viewBox="0 0 20 20" fill="currentColor" width="18" height="18" aria-hidden="true">
              <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd"/>
            </svg>
            <input
              type="text"
              id="main-tag-search"
              class="tags-main-input mono"
              placeholder="Search topics (e.g. ai-agents, zero-trust, api, network-security)..."
              aria-label="Search topics"
            />
          </div>
        </div>
      </div>

      <!-- No results message -->
      <div id="no-tags-found" class="no-tags-found" style="display: none;">
        <p>No topics found matching your search.</p>
      </div>

      <!-- Tag cards grid -->
      <div class="tags-grid" id="tags-grid">
        {allTags.map(({ tag, count }) => (
          <a class="tag-card" href={`/tags/${tag}/`} data-tag={tag.toLowerCase()}>
            <span class="tag-card-hash">#</span>
            <span class="tag-card-name">{tag}</span>
            <span class="tag-card-count mono">{count} post{count !== 1 ? 's' : ''}</span>
          </a>
        ))}
      </div>
    </main>
  </div>
</Layout>

<style>
  /* ── Page shell ── */
  .tags-page-wrap {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 2rem;
    max-width: 1100px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 5rem;
    align-items: start;
  }

  @media (max-width: 768px) {
    .tags-page-wrap {
      grid-template-columns: 1fr;
      padding: 1.5rem 1rem 4rem;
      gap: 1.5rem;
    }
    .tags-sidebar {
      display: none;
    }
    .tags-h1 {
      font-size: 1.85rem;
    }
    .tags-grid {
      grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
      gap: 0.65rem;
    }
  }

  /* ── Left Sidebar ── */
  .tags-sidebar {
    position: sticky;
    top: 5rem;
  }

  .sidebar-card {
    background: #fff;
    border: 1.5px solid #e2e8f0;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 2px 12px rgba(15, 23, 42, 0.04);
  }

  .sidebar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.1rem 0.75rem;
    border-bottom: 1px solid #f1f5f9;
    background: #fafbfd;
  }

  .sidebar-title {
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #334155;
  }

  .sidebar-count {
    font-size: 0.75rem;
    font-weight: 700;
    color: #fff;
    background: #2563eb;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
  }

  .sidebar-search-box {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 0.9rem;
    border-bottom: 1px solid #f1f5f9;
    background: #ffffff;
    transition: background 0.15s ease;
  }

  .sidebar-search-box:focus-within {
    background: #eff6ff;
  }

  .sidebar-search-icon {
    color: #94a3b8;
    flex-shrink: 0;
    transition: color 0.15s ease;
  }

  .sidebar-search-box:focus-within .sidebar-search-icon {
    color: #2563eb;
  }

  .sidebar-search-input {
    width: 100%;
    border: none;
    outline: none;
    font-size: 0.8rem;
    color: #0f172a;
    background: transparent;
  }

  .sidebar-search-input::placeholder {
    color: #94a3b8;
  }

  .sidebar-tags-list {
    display: flex;
    flex-direction: column;
    max-height: 70vh;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: #e2e8f0 transparent;
  }

  .sidebar-tag-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.6rem 1.1rem;
    text-decoration: none;
    color: #475467;
    font-size: 0.85rem;
    font-weight: 600;
    border-bottom: 1px solid #f8fafc;
    transition: all 0.12s ease;
    gap: 0.5rem;
  }

  .sidebar-tag-row:last-child { border-bottom: none; }

  .sidebar-tag-row:hover {
    background: #eff6ff;
    color: #1d4ed8;
  }

  .sidebar-tag-name {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sidebar-tag-num {
    font-size: 0.72rem;
    font-weight: 700;
    color: #2563eb;
    background: #dbeafe;
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    flex-shrink: 0;
  }

  /* ── Right: Hero + Grid ── */
  .tags-main { min-width: 0; }

  .tags-hero {
    margin-bottom: 2rem;
  }

  .tags-eyebrow {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: #2563eb;
    text-transform: uppercase;
    margin: 0 0 0.6rem;
    display: block;
  }

  .tags-h1 {
    font-size: 2.2rem;
    font-weight: 900;
    color: #0f172a;
    letter-spacing: -0.03em;
    margin: 0 0 0.6rem;
  }

  .tags-sub {
    color: #64748b;
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0 0 1.5rem;
  }

  /* ── Main Search Bar ── */
  .tags-search-wrap {
    margin-top: 1rem;
  }

  .tags-search-input-box {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: #ffffff;
    border: 1.5px solid #cbd5e1;
    border-radius: 12px;
    padding: 0.75rem 1.1rem;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
    transition: all 0.15s ease;
  }

  .tags-search-input-box:focus-within {
    border-color: #2563eb;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
  }

  .tags-search-svg {
    color: #64748b;
    flex-shrink: 0;
  }

  .tags-search-input-box:focus-within .tags-search-svg {
    color: #2563eb;
  }

  .tags-main-input {
    width: 100%;
    border: none;
    outline: none;
    font-size: 0.92rem;
    color: #0f172a;
    background: transparent;
  }

  .tags-main-input::placeholder {
    color: #94a3b8;
  }

  .no-tags-found {
    text-align: center;
    padding: 2.5rem;
    background: #f8fafc;
    border: 1.5px dashed #e2e8f0;
    border-radius: 12px;
    color: #64748b;
    font-size: 0.95rem;
  }

  /* ── Tag cards grid ── */
  .tags-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 0.85rem;
  }

  .tag-card {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background: #fff;
    border: 1.5px solid #e2e8f0;
    border-radius: 10px;
    padding: 0.75rem 1rem;
    text-decoration: none;
    color: #0f172a;
    transition: all 0.16s ease;
    box-shadow: 0 1px 6px rgba(15, 23, 42, 0.03);
  }

  .tag-card:hover {
    border-color: #2563eb;
    background: #eff6ff;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(37, 99, 235, 0.1);
  }

  .tag-card-hash {
    font-size: 1rem;
    font-weight: 900;
    color: #2563eb;
    flex-shrink: 0;
  }

  .tag-card-name {
    flex: 1;
    font-size: 0.88rem;
    font-weight: 700;
    color: #0f172a;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .tag-card:hover .tag-card-name { color: #1d4ed8; }

  .tag-card-count {
    font-size: 0.72rem;
    font-weight: 700;
    color: #2563eb;
    background: #dbeafe;
    padding: 0.12rem 0.45rem;
    border-radius: 999px;
    flex-shrink: 0;
  }

  .mono { font-family: 'Courier New', Courier, monospace; }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    var sidebarInput = document.getElementById('sidebar-tag-search');
    var mainInput = document.getElementById('main-tag-search');
    var sidebarRows = document.querySelectorAll('#sidebar-tags-list .sidebar-tag-row');
    var gridCards = document.querySelectorAll('#tags-grid .tag-card');
    var countBadge = document.getElementById('sidebar-count');
    var noTagsBox = document.getElementById('no-tags-found');

    function filterTags(query, source) {
      query = (query || '').trim().toLowerCase().replace(/^#/, '');
      var visibleCount = 0;

      // Filter sidebar rows
      sidebarRows.forEach(function(row) {
        var tag = row.getAttribute('data-tag') || '';
        if (!query || tag.includes(query)) {
          row.style.display = 'flex';
          visibleCount++;
        } else {
          row.style.display = 'none';
        }
      });

      // Filter grid cards
      var gridMatches = 0;
      gridCards.forEach(function(card) {
        var tag = card.getAttribute('data-tag') || '';
        if (!query || tag.includes(query)) {
          card.style.display = 'flex';
          gridMatches++;
        } else {
          card.style.display = 'none';
        }
      });

      if (countBadge) countBadge.textContent = visibleCount;
      if (noTagsBox) noTagsBox.style.display = gridMatches === 0 ? 'block' : 'none';

      // Keep inputs in sync
      if (source === 'sidebar' && mainInput && mainInput.value !== query) {
        mainInput.value = query;
      } else if (source === 'main' && sidebarInput && sidebarInput.value !== query) {
        sidebarInput.value = query;
      }
    }

    if (sidebarInput) {
      sidebarInput.addEventListener('input', function() {
        filterTags(this.value, 'sidebar');
      });
    }

    if (mainInput) {
      mainInput.addEventListener('input', function() {
        filterTags(this.value, 'main');
      });
    }
  });
</script>
